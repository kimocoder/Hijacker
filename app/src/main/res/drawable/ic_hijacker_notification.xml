        android:fillColor="#00000000"
        android:strokeWidth="3"
        android:strokeColor="#1A000000"
        android:pathData="M48,12 A36,36 0 1,1 47.999,12 Z" />

    <!-- wifi symbol in back (four arcs for more detail) -->
