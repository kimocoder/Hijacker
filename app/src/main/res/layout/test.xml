<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="5dp"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <!-- Material 3 linear progress indicator -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/test_progress"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        app:trackThickness="4dp"
        android:contentDescription="@string/test_progress_desc"
        app:indicatorColor="@color/colorAccent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingEnd="35dp"
        android:paddingStart="20dp"
        android:paddingTop="10dp">

        <!-- Tool rows: icon, label, status chip -->
        <!-- RecyclerView to display tool rows dynamically -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/test_tools_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:overScrollMode="never" />

        <!-- Command output area: MaterialTextView inside a scrolling container is preferred -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/current_cmd"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clickable="true"
            android:lines="4"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:paddingTop="6dp"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:typeface="monospace"
            android:focusable="true"
            android:ellipsize="end"
            android:scrollbars="vertical"
            android:paddingBottom="8dp"
            android:contentDescription="@string/current_command_desc"
            app:lineHeight="18sp" />

    </LinearLayout>
</LinearLayout>