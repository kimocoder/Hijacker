# shellcheck disable=SC2006

prefix='/run/media/kimocoder/b01aaa61-27c1-4909-a818-c24330bd9af0/kali-nethunter-tools/out/armv7a-linux-androideabi/curl'
# Used in 'libdir'
# shellcheck disable=SC2034
exec_prefix="${prefix}"
# shellcheck disable=SC2034
includedir="${prefix}/include"

usage()
{
  cat <<EOF
Usage: curl-config [OPTION]

Available values for OPTION include:

  --built-shared        says 'yes' if libcurl was built shared
  --ca                  CA bundle install path
  --cc                  compiler
  --cflags              preprocessor and compiler flags
  --checkfor [version]  check for (lib)curl of the specified version
  --configure           the arguments given to configure when building curl
  --features            newline separated list of enabled features
  --help                display this help and exit
  --libs                library linking information
  --prefix              curl install prefix
  --protocols           newline separated list of enabled protocols
  --ssl-backends        output the SSL backends libcurl was built to support
  --static-libs         static libcurl library linking information
  --version             output version information
  --vernum              output version as a hexadecimal number
EOF

  exit "$1"
}

if test "$#" -eq 0; then
  usage 1
fi

while test "$#" -gt 0; do
  case "$1" in
  --built-shared)
    echo 'no'
    ;;

  --ca)
    echo '/system/etc/security/cacerts'
    ;;

  --cc)
    echo '/home/kimocoder/Android/Sdk/ndk/27.2.12479018/toolchains/llvm/prebuilt/linux-x86_64/bin/armv7a-linux-androideabi21-clang'
    ;;

  --prefix)
    echo "$prefix"
    ;;

  --feature|--features)
    for feature in alt-svc AsynchDNS HSTS HTTPS-proxy IPv6 Largefile libz NTLM SSL threadsafe TLS-SRP UnixSockets ''; do
      test -n "$feature" && echo "$feature"
    done
    ;;

  --protocols)
    # shellcheck disable=SC2043
    for protocol in DICT FILE FTP FTPS GOPHER GOPHERS HTTP HTTPS IMAP IMAPS IPFS IPNS MQTT POP3 POP3S RTSP SMB SMBS SMTP SMTPS TELNET TFTP WS WSS; do
      echo "$protocol"
    done
    ;;

  --version)
    echo 'libcurl 8.18.0-DEV'
    exit 0
    ;;

  --checkfor)
    checkfor="$2"
    cmajor=`echo "$checkfor" | cut -d. -f1`
    cminor=`echo "$checkfor" | cut -d. -f2`
    # when extracting the patch part we strip off everything after a
    # dash as that's used for things like version 1.2.3-pre1
    cpatch=`echo "$checkfor" | cut -d. -f3 | cut -d- -f1`

    vmajor=`echo '8.18.0-DEV' | cut -d. -f1`
    vminor=`echo '8.18.0-DEV' | cut -d. -f2`
    # when extracting the patch part we strip off everything after a
    # dash as that's used for things like version 1.2.3-pre1
    vpatch=`echo '8.18.0-DEV' | cut -d. -f3 | cut -d- -f1`

    if test "$vmajor" -gt "$cmajor"; then
      exit 0
    fi
    if test "$vmajor" -eq "$cmajor"; then
      if test "$vminor" -gt "$cminor"; then
        exit 0
      fi
      if test "$vminor" -eq "$cminor"; then
        if test "$cpatch" -le "$vpatch"; then
          exit 0
        fi
      fi
    fi

    echo "requested version $checkfor is newer than existing 8.18.0-DEV"
    exit 1
    ;;

  --vernum)
    echo '081200'
    exit 0
    ;;

  --help)
    usage 0
    ;;

  --cflags)
    if test "${prefix}/include" = '/usr/include'; then
      echo '-DCURL_STATICLIB'
    else
      echo "-DCURL_STATICLIB -I${prefix}/include"
    fi
    ;;

  --libs)
    if test "${exec_prefix}/lib" != '/usr/lib' -a "${exec_prefix}/lib" != '/usr/lib64'; then
      curllibdir="-L${exec_prefix}/lib "
    else
      curllibdir=''
    fi
    if test 'no' = 'no'; then
      echo "${curllibdir}-lcurl -lssl -lcrypto -lz -lz -ldl"
    else
      echo "${curllibdir}-lcurl"
    fi
    ;;

  --ssl-backends)
    echo 'OpenSSL'
    ;;

  --static-libs)
    if test 'yes' != 'no'; then
      echo "${exec_prefix}/lib/libcurl.a -L/run/media/kimocoder/b01aaa61-27c1-4909-a818-c24330bd9af0/kali-nethunter-tools/out/armv7a-linux-androideabi/zlib/lib -L/run/media/kimocoder/b01aaa61-27c1-4909-a818-c24330bd9af0/kali-nethunter-tools/out/armv7a-linux-androideabi/openssl/lib -lssl -lcrypto -lz -lz -ldl"
    else
      echo 'curl was built with static libraries disabled' >&2
      exit 1
    fi
    ;;

  --configure)
    echo " '--host=armv7a-linux-androideabi' '--prefix=/run/media/kimocoder/b01aaa61-27c1-4909-a818-c24330bd9af0/kali-nethunter-tools/out/armv7a-linux-androideabi/curl' '--with-openssl=/run/media/kimocoder/b01aaa61-27c1-4909-a818-c24330bd9af0/kali-nethunter-tools/out/armv7a-linux-androideabi/openssl' '--with-ca-bundle=/system/etc/security/cacerts' '--with-zlib=/run/media/kimocoder/b01aaa61-27c1-4909-a818-c24330bd9af0/kali-nethunter-tools/out/armv7a-linux-androideabi/zlib' 'CPPFLAGS=-I/run/media/kimocoder/b01aaa61-27c1-4909-a818-c24330bd9af0/kali-nethunter-tools/out/armv7a-linux-androideabi/openssl/include -I/run/media/kimocoder/b01aaa61-27c1-4909-a818-c24330bd9af0/kali-nethunter-tools/out/armv7a-linux-androideabi/zlib/include' 'LDFLAGS=-L/run/media/kimocoder/b01aaa61-27c1-4909-a818-c24330bd9af0/kali-nethunter-tools/out/armv7a-linux-androideabi/openssl/lib -L/run/media/kimocoder/b01aaa61-27c1-4909-a818-c24330bd9af0/kali-nethunter-tools/out/armv7a-linux-androideabi/zlib/lib' '--without-libpsl' '--disable-ldap' '--disable-ldaps' '--enable-static' '--disable-shared' '--disable-manual' 'CC=/home/kimocoder/Android/Sdk/ndk/27.2.12479018/toolchains/llvm/prebuilt/linux-x86_64/bin/armv7a-linux-androideabi21-clang' 'CXX=/home/kimocoder/Android/Sdk/ndk/27.2.12479018/toolchains/llvm/prebuilt/linux-x86_64/bin/armv7a-linux-androideabi21-clang++' 'CFLAGS=--sysroot=/home/kimocoder/Android/Sdk/ndk/27.2.12479018/toolchains/llvm/prebuilt/linux-x86_64/sysroot -fPIC -O2 -D_GNU_SOURCE -fno-emulated-tls -I/run/media/kimocoder/b01aaa61-27c1-4909-a818-c24330bd9af0/kali-nethunter-tools/out/armv7a-linux-androideabi/zlib/include' 'CXXFLAGS=--sysroot=/home/kimocoder/Android/Sdk/ndk/27.2.12479018/toolchains/llvm/prebuilt/linux-x86_64/sysroot -fPIC -O2 -D_GNU_SOURCE -fno-emulated-tls -I/run/media/kimocoder/b01aaa61-27c1-4909-a818-c24330bd9af0/kali-nethunter-tools/out/armv7a-linux-androideabi/zlib/include' 'LDFLAGS=--sysroot=/home/kimocoder/Android/Sdk/ndk/27.2.12479018/toolchains/llvm/prebuilt/linux-x86_64/sysroot -Wl,-z,max-page-size=16384 -static -L/run/media/kimocoder/b01aaa61-27c1-4909-a818-c24330bd9af0/kali-nethunter-tools/out/armv7a-linux-androideabi/zlib/lib' 'LIBS=-lz' 'host_alias=armv7a-linux-androideabi'"
    ;;

  *)
    echo "unknown option: $1"
    usage 1
    ;;
  esac
  shift
done

exit 0
